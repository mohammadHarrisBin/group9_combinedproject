================================================================================
MAKEFILE VARIABLES & COMPILER FLAGS
================================================================================
OPT       Optimization level (Default: -O2). Examples: -O0, -O1, -O2, -O3
CPU       Architecture/CPU tuning flags (Default: empty).
          Examples:
          - Raspberry Pi 5 (Cortex-A76): CPU="-mcpu=cortex-a76" or CPU="-march=native"
          - x86_64 Laptop / WSL:         CPU="-march=native" or CPU="-mtune=native"
SHORT_N   Short SMA window size (Default: 15, test20 uses 3)
LONG_N    Long SMA window size (Default: 100, test20 uses 5)

Example build with overrides:
make clean && make all OPT=-O3 CPU="-mcpu=cortex-a76" SHORT_N=15 LONG_N=100

================================================================================
BUILD COMMANDS (Compile Only)
================================================================================
make all                Build every target (Stage 0, tests, A, A+, B variants, C)
make clean              Delete bin/ and plots/ directories
make directories        Create bin/ and plots/ directories

# Stage 0 (Compiler optimization comparison)
make stage0             Builds bin/parta_O0..O3 and bin/partb_O0..O3

# Stage A & Indicator Unit Tests
make test_tradeio       Build bin/test_tradeio
make test_vwap          Build bin/test_vwap
make test_ohlc          Build bin/test_ohlc
make test_sma           Build bin/test_sma
make test_signal        Build bin/test_signal
make stageA             Build bin/stageA_engine
make test20             Build bin/test20_stageA_engine (hardcodes SHORT_N=3 LONG_N=5)
make check              Build test20, run it, and diff against Datasets/Group09/test20_expected.txt

# Stage A+ (Fast reader / I/O optimization)
make stageA_plus        Build bin/stageA_plus_engine

# Stage B (Algorithmic & Memory Variants)
make stageB             Build all 4 Stage B engines below
make stageB_naive       Build bin/stageB_naive_engine (Naive O(N) SMA)
make stageB_running     Build bin/stageB_running_engine (Running-sum O(1) SMA)
make stageB_fp          Build bin/stageB_fp_engine (Fixed-point long long arithmetic)
make stageB_malloc      Build bin/stageB_malloc_engine (Dynamic malloc allocation)

# Stage C (Rival-bot reaction race simulation)
make stageC             Build bin/stageC_engine

================================================================================
RUN & PLOT COMMANDS (Execute Binaries & Generate Gnuplot PNGs)
================================================================================
# Direct Binary Execution
./bin/parta_O0          (also parta_O1, parta_O2, parta_O3)
./bin/partb_O0          (also partb_O1, partb_O2, partb_O3)
./bin/test_tradeio
./bin/test_vwap
./bin/test_ohlc
./bin/test_sma
./bin/test_signal
./bin/stageA_engine
./bin/test20_stageA_engine
./bin/stageA_plus_engine
make run_stageB_naive       (or ./bin/stageB_naive_engine)
make run_stageB_running     (or ./bin/stageB_running_engine)
./bin/stageB_fp_engine
./bin/stageB_malloc_engine
./bin/stageC_engine 1000    (takes rival reaction time R in microseconds as arg)

# Automated Run + Gnuplot Rendering (Outputs .dat and .png to plots/)
make plot_stageA            -> plots/signals_stageA.dat & .png
make plot_stageA_plus       -> plots/signals_stageA_plus.dat & .png
make plot_stageB_naive      -> plots/signals_stageB_naive.dat & .png
make plot_stageB_running    -> plots/signals_stageB_running.dat & .png
make plot_stageB_fp         -> plots/signals_stageB_fp.dat & .png
make plot_stageB_malloc     -> plots/signals_stageB_malloc.dat & .png
make plot_stageC            -> plots/rival_sweep.dat & plots/rival_sweep.png (runs with R=1000)

================================================================================
COMMON BENCHMARK COMBOS (WSL vs Raspberry Pi 5)
================================================================================
# 1. Clean + build with -O2 and native CPU tuning (WSL or Pi 5):
make clean && make all OPT=-O2 CPU="-march=native"

# 2. Clean + build specifically for Raspberry Pi 5 Cortex-A76 with -O3:
make clean && make all OPT=-O3 CPU="-mcpu=cortex-a76"

# 3. Run full correctness + Stage B comparison:
make check && make run_stageB_naive && make run_stageB_running && ./bin/stageB_fp_engine && ./bin/stageB_malloc_engine

# 4. Generate all plots in one go:
make plot_stageA plot_stageA_plus plot_stageB_naive plot_stageB_running plot_stageB_fp plot_stageB_malloc plot_stageC